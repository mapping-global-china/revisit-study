{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.3/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "MGC Dashboard Think-Aloud Study",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-08-05",
    "description": "A screen-recording and think-aloud study for the MGC dashboard projects page.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "mgc-dashboard-projects-think-aloud/assets/introduction.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": true,
    "windowEventDebounceTime": 200,
    "recordAudio": true,
    "recordScreen": true,
    "recordScreenFPS": 30,
    "participantNameField": "introduction.participantName"
  },
  "importedLibraries": [
    "screen-recording"
  ],
  "components": {
    "introduction": {
      "type": "markdown",
      "path": "mgc-dashboard-projects-think-aloud/assets/introduction.md",
      "response": [
        {
          "id": "participantName",
          "prompt": "Please enter your name so we can reference your recording later",
          "location": "belowStimulus",
          "type": "shortText",
          "placeholder": "Your name"
        }
      ]
    },
    "mgc_dashboard_projects": {
      "type": "website",
      "path": "https://mgc-vis.netlify.app/dashboard/projects",
      "response": [],
      "instruction": "Explore this dashboard page as you naturally would. Think aloud while you work by describing what you are trying to do, what you notice, and anything confusing or surprising."
    },
    "debrief": {
      "type": "markdown",
      "path": "mgc-dashboard-projects-think-aloud/assets/debrief.md",
      "response": [],
      "recordAudio": false,
      "recordScreen": false
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "$screen-recording.components.screenRecordingPermission",
      "mgc_dashboard_projects",
      "debrief"
    ]
  }
}
