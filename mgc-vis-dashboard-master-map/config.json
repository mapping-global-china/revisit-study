{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.3/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "MGC Vis Dashboard - Master Map",
    "version": "pilot",
    "authors": [
      "The reVISit Team"
    ],
    "date": "2026-08-21",
    "description": "A screen-recording and think-aloud study for the MGC master map dashboard page.",
    "organizations": [
      "University of Utah",
      "WPI"
    ]
  },
  "uiConfig": {
    "contactEmail": "contact@revisit.dev",
    "helpTextPath": "mgc-vis-dashboard-master-map/assets/introduction.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": false,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "windowEventDebounceTime": 200,
    "recordAudio": true,
    "recordScreen": true,
    "recordScreenFPS": 30,
    "participantNameField": "introduction.participantName",
    "showTitleBar": false
  },
  "importedLibraries": [
    "screen-recording"
  ],
  "components": {
    "introduction": {
      "type": "markdown",
      "path": "mgc-vis-dashboard-master-map/assets/introduction.md",
      "response": [
        {
          "id": "participantName",
          "prompt": "Please enter your name so we can reference your recording later",
          "location": "belowStimulus",
          "type": "shortText",
          "placeholder": "Your name"
        }
      ]
    },
    "mgc_master_map": {
      "type": "website",
      "path": "https://mgc-vis.shresthalucky.com.np/dashboard/master",
      "response": [],
      "instruction": "Explore this master map page as you naturally would. Verbally describe what you are trying to do, what you notice, and anything confusing or surprising. Click Next when done exploring.",
      "instructionLocation": "aboveStimulus"
    },
    "debrief": {
      "type": "markdown",
      "path": "mgc-vis-dashboard-master-map/assets/debrief.md",
      "response": [
        {
          "id": "feedbackGeneral",
          "prompt": "Do you have any feedback on the master map page? What worked well, and what was confusing or frustrating?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "Enter your feedback here.",
          "required": false
        },
        {
          "id": "feedbackImprovements",
          "prompt": "Is there anything you would change or add to improve this page?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "Enter your suggestions here.",
          "required": false
        }
      ],
      "recordAudio": false,
      "recordScreen": false
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "$screen-recording.components.screenRecordingPermission",
      "mgc_master_map",
      "debrief"
    ]
  }
}
